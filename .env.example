# Copy this file to .env.local for local development.
# In Vercel, set these in: Project -> Settings -> Environment Variables
# (do NOT commit real values to git)

# --- Supabase -------------------------------------------------------------
# Both prefixed (VITE_) and unprefixed names are read by the build.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- Gemini (Google Generative AI) ----------------------------------------
# WARNING: this key is inlined into the public JS bundle. Anyone visiting
# your site can extract it. Restrict the key in Google AI Studio (HTTP
# referrers + tight quotas) and rotate it if leaked.
GEMINI_API_KEY=your-gemini-api-key

# --- Local dev server only (server.ts) ------------------------------------
# Not used by the Vercel build.
SESSION_SECRET=change-me-in-local-dev

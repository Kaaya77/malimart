# Copy this file to .env.local for local development.
# In Vercel, set these in: Project → Settings → Environment Variables
# Set ALL THREE for Production, Preview, and Development environments.
# Do NOT commit real values to git.

# --- Supabase -----------------------------------------------------------
# Get from: https://supabase.com/dashboard/project/ubpapxdmqlepynonhaeo/settings/api
SUPABASE_URL=https://ubpapxdmqlepynonhaeo.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-from-supabase-dashboard

# VITE_ prefixed versions also work (Vite reads both):
# VITE_SUPABASE_URL=https://ubpapxdmqlepynonhaeo.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Gemini (Google Generative AI) -------------------------------------
# Get from: https://aistudio.google.com/app/apikey
# WARNING: This key is inlined into the public JS bundle. Restrict it
# to your domain in Google AI Studio and set usage quotas.
GEMINI_API_KEY=your-gemini-api-key

# --- Local dev server only (not used by Vercel build) ------------------
SESSION_SECRET=change-me-in-local-dev
